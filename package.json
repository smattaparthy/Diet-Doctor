{
  "name": "cultural-diet-app",
  "version": "1.0.0",
  "description": "Cultural Diet App - Ayurvedic and Traditional Nutrition Management",
  "main": "dist/electron/main.js",
  "homepage": "./",
  "scripts": {
    "build": "tsc && npm run build:frontend",
    "build:frontend": "react-scripts build",
    "start": "node dist/server.js",
    "dev:backend": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:electron": "concurrently \"npm run dev:backend\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:frontend": "react-scripts start",
    "electron": "electron .",
    "pack": "electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "migrate": "ts-node src/database/migrate.ts",
    "seed": "ts-node src/database/seed.ts",
    "db:seed:recipes": "ts-node src/database/seed_recipes.ts",
    "test": "jest",
    "test:backend": "jest --testPathPattern=tests/backend",
    "test:frontend": "react-scripts test",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:cultural": "jest --testPathPattern=tests/cultural",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:security": "jest --testPathPattern=tests/security",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts electron/**/*.*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.3",
    "axios": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^1.2.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.29.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.312.0",
    "morgan": "^1.10.0",
    "pdfkit": "^0.17.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "concurrently": "^7.6.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "wait-on": "^7.0.1"
  },
  "keywords": [
    "ayurvedic",
    "diet",
    "nutrition",
    "cultural",
    "hindu",
    "unani",
    "traditional",
    "meal-planning"
  ],
  "author": "Cultural Diet Team",
  "license": "MIT",
  "build": {
    "appId": "com.culturaldiet.app",
    "productName": "Cultural Diet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.health-and-fitness",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "cultural-diet",
      "repo": "cultural-diet-app"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
