# Multi-stage Frontend Dockerfile for Cultural Diet App
# React + Electron Development and Build

# Stage 1: Development stage
FROM node:18-alpine3.18 AS development

# Set working directory
WORKDIR /app

# Install system dependencies for Electron and sqlite3
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    sqlite-dev \
    xvfb \
    gtk+3.0 \
    libxss1 \
    gconf-service \
    libasound2 \
    libatk1.0-0 \
    libc6 \
    libcairo-gobject2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgcc1 \
    libgconf-2-4 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    ca-certificates \
    fonts-liberation \
    libappindicator1 \
    libnss3 \
    lsb-release \
    xdg-utils

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# Install all dependencies
RUN npm ci && npm cache clean --force

# Copy source code
COPY src/ ./src/
COPY electron/ ./electron/
COPY public/ ./public/

# Expose React development server port
EXPOSE 3001

# Environment variables for development
ENV NODE_ENV=development
ENV PORT=3001
ENV REACT_APP_API_URL=http://localhost:3000
DISPLAY=:99

# Start Xvfb and React development server
CMD ["sh", "-c", "Xvfb :99 -screen 0 1024x768x24 > /dev/null 2>&1 & npm run dev:frontend"]

# Stage 2: Build stage
FROM node:18-alpine3.18 AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    sqlite-dev \
    xvfb \
    gtk+3.0 \
    libxss1

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Copy source code
COPY src/ ./src/
COPY electron/ ./electron/
COPY public/ ./public/

# Set environment for production build
ENV NODE_ENV=production
ENV GENERATE_SOURCEMAP=false

# Build the application
RUN npm run build

# Build Electron app
RUN Xvfb :99 -screen 0 1024x768x24 > /dev/null 2>&1 & \
    npm run dist

# Stage 3: Production stage (Electron app container)
FROM node:18-alpine3.18 AS production

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S culturaldiet -u 1001

WORKDIR /app

# Install runtime dependencies for Electron
RUN apk add --no-cache \
    libstdc++ \
    libgcc \
    gtk+3.0 \
    libxss1 \
    gconf-service \
    libasound2 \
    libatk1.0-0 \
    libc6 \
    libcairo-gobject2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libnspr4 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    ca-certificates \
    fonts-liberation \
    libappindicator1 \
    libnss3 \
    lsb-release \
    xdg-utils \
    xvfb

# Copy built Electron app from builder stage
COPY --from=builder --chown=culturaldiet:nodejs /app/release ./release

# Copy necessary runtime files
COPY --from=builder --chown=culturaldiet:nodejs /app/dist ./dist
COPY --from=builder --chown=culturaldiet:nodejs /app/node_modules ./node_modules

# Create directories for user data
RUN mkdir -p /app/data && \
    chown -R culturaldiet:nodejs /app/data

USER culturaldiet

# Environment variables
ENV NODE_ENV=production
ENV ELECTRON_IS_DEV=0

# Start Electron app with virtual display
CMD ["sh", "-c", "Xvfb :99 -screen 0 1024x768x24 > /dev/null 2>&1 && npm start"]

# Labels
LABEL maintainer="Cultural Diet Team"
LABEL version="1.0.0"
LABEL description="Cultural Diet App Frontend - Electron Desktop Application"